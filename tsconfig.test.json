{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "types": ["node", "vitest"],
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
