{
  "name": "backend",
  "version": "1.0.0",
  "description": "Blog with Markdown Editor, Pexels photos, PDF generation - Backend",
  "license": "ISC",
  "author": "Catevika Web Dev",
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "blog",
    "markdown",
    "pdf",
    "pexels",
    "photos",
    "posts"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:merge": "npx vitest-coverage-merge coverage/unit coverage/integration -o coverage/merged",
    "coverage:view": "npm run coverage:merge && start coverage/merged/index.html",
    "test:watch:unit": "vitest --config vitest.unit.config.ts --watch",
    "test:watch:integration": "vitest --config vitest.integration.config.ts --watch",
    "start": "NODE_ENV=production tsx src/server.ts",
    "build": "tsc",
    "preview": "NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.3.0",
    "mongoose": "^9.7.0",
    "multer": "^2.1.1",
    "puppeteer": "^25.1.0",
    "rate-limiter-flexible": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@express-rate-limit/tsconfig": "^1.0.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "vitest-coverage-merge": "^0.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "mongodb-memory-server@11.2.0": true,
    "puppeteer@25.1.0": true
  }
}
