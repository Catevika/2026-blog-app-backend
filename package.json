{
  "name": "backend",
  "version": "1.0.0",
  "description": "Blog with Markdown Editor, Pexels photos, PDF generation - Backend",
  "license": "ISC",
  "author": "Catevika Web Dev",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.14.1"
  },
  "keywords": [
    "blog",
    "markdown",
    "pdf",
    "pexels",
    "photos",
    "posts"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env.dev --import tsx --watch src/server.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "coverage:merge": "npx vitest-coverage-merge coverage/unit coverage/integration -o coverage/merged",
    "coverage:view": "npm run coverage:merge && start coverage/merged/index.html",
    "test:watch:unit": "vitest --config vitest.unit.config.ts --watch",
    "test:watch:integration": "vitest --config vitest.integration.config.ts --watch",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "preview": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "eslint-plugin-prettier": "^5.5.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.3",
    "multer": "^2.5.0",
    "puppeteer": "^25.16.0",
    "rate-limiter-flexible": "^11.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@express-rate-limit/tsconfig": "^1.0.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vitest-coverage-merge": "^0.2.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true,
    "puppeteer@25.16.0": true
  }
}
